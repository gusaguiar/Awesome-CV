---
import Section from '@/components/ui/Section.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Tag from '@/components/ui/Tag.astro';
import { t, type Locale } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  resume: CollectionEntry<'resume'>['data'];
  locale: Locale;
}

const { resume, locale } = Astro.props;

// Agrupa certificados por emissor para melhor leitura
const byIssuer = resume.certificates.reduce<Record<string, typeof resume.certificates>>((acc, cert) => {
  if (!acc[cert.issuer]) acc[cert.issuer] = [];
  acc[cert.issuer].push(cert);
  return acc;
}, {});

// Cores dos issuers
const issuerVariant: Record<string, 'emerald' | 'sky' | 'violet' | 'slate'> = {
  'Microsoft': 'sky',
  'Google Cloud': 'emerald',
  'SAS': 'violet',
  'Udacity': 'slate',
  'ENAP': 'emerald',
};
---

<Section title={t(locale, 'section.certificates')} id="certificados">
  <div class="space-y-4">
    {Object.entries(byIssuer).map(([issuer, certs]) => (
      <GlassCard>
        <div class="mb-3 flex items-center gap-2">
          <Tag variant={issuerVariant[issuer] ?? 'slate'}>{issuer}</Tag>
        </div>
        <ul class="space-y-2">
          {certs.map((cert) => (
            <li class="flex items-start justify-between gap-3">
              <span class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                <span class="mt-1.5 shrink-0 h-1.5 w-1.5 rounded-full bg-violet-400/70" aria-hidden="true"></span>
                {cert.credential
                  ? <a href={cert.credential} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{cert.title}</a>
                  : cert.title
                }
              </span>
              <time class="shrink-0 text-xs text-slate-400 dark:text-slate-500 font-mono whitespace-nowrap">{cert.date}</time>
            </li>
          ))}
        </ul>
      </GlassCard>
    ))}
  </div>
</Section>
