---
import GlassCard from '@/components/ui/GlassCard.astro';
import { t, type Locale } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  resume: CollectionEntry<'resume'>['data'];
  locale: Locale;
  pdfHref: string;
}

const { resume, locale, pdfHref } = Astro.props;
const { personal } = resume;
const { contact } = personal;

// Links sociais com labels e ícones SVG inline
const socialLinks = [
  {
    href: contact.linkedin,
    label: 'LinkedIn',
    show: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    href: contact.github,
    label: 'GitHub',
    show: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    href: contact.lattes,
    label: 'Lattes',
    show: !!contact.lattes,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>`,
  },
  {
    href: contact.researchGate,
    label: 'ResearchGate',
    show: !!contact.researchGate,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>`,
  },
  {
    href: contact.orcid,
    label: 'ORCID',
    show: !!contact.orcid,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm-1.04 7.8h-.96V6.6h.96v1.2zm0 8.4h-.96V9h.96v7.2zm2.16 0h-.96V9h.96v7.2zm2.4-3.72c0 2.16-1.56 3.72-3.72 3.72h-1.44V9h1.44c2.16 0 3.72 1.56 3.72 3.72z"/></svg>`,
  },
].filter((l) => l.show);
---

<GlassCard class="mb-8">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">

    <!-- Informações principais -->
    <div class="flex-1">
      <h1 class="mb-1 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl">
        {personal.name}
      </h1>

      <p class="mb-4 text-base font-medium text-emerald-600 dark:text-emerald-400">
        {personal.title}
      </p>

      <!-- Localização e contato -->
      <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-600 dark:text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {contact.location}
        </span>

        <a
          href={`mailto:${contact.email}`}
          class="flex items-center gap-1.5 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {contact.email}
        </a>

        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.63 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.54 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.5a16 16 0 0 0 6 6l.88-.88a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {contact.phone}
        </span>
      </div>

      <!-- Links sociais -->
      <div class="flex flex-wrap gap-2">
        {socialLinks.map(({ href, label, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200/60
                   bg-white/60 px-3 py-1.5 text-xs font-medium text-slate-600
                   hover:border-emerald-400/60 hover:text-emerald-700
                   dark:border-slate-700/60 dark:bg-slate-800/40
                   dark:text-slate-400 dark:hover:text-emerald-400
                   transition-colors"
          >
            <span set:html={icon} />
            {label}
          </a>
        ))}
      </div>
    </div>

    <!-- Botão de download PDF -->
    <div class="shrink-0">
      <a
        href={pdfHref}
        download
        class="inline-flex items-center gap-2 rounded-xl
               bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white
               shadow-[0_4px_16px_rgba(16,185,129,0.3)]
               hover:bg-emerald-700 hover:shadow-[0_4px_20px_rgba(16,185,129,0.4)]
               dark:bg-emerald-500 dark:hover:bg-emerald-600
               transition-all duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        {t(locale, 'hero.downloadPdf')}
      </a>
    </div>
  </div>

  <!-- Citações -->
  {personal.quote && personal.quote.length > 0 && (
    <div class="mt-6 grid gap-3 border-t border-white/20 pt-6 dark:border-white/10 sm:grid-cols-2">
      {personal.quote.map(({ text, attribution }) => (
        <blockquote class="rounded-xl bg-white/30 p-4 dark:bg-slate-800/30">
          <p class="text-sm italic leading-relaxed text-slate-700 dark:text-slate-300">
            "{text}"
          </p>
          <footer class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            — {attribution}
          </footer>
        </blockquote>
      ))}
    </div>
  )}
</GlassCard>
