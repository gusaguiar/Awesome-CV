---
import Section from '@/components/ui/Section.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import { t, type Locale } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  resume: CollectionEntry<'resume'>['data'];
  locale: Locale;
}

const { resume, locale } = Astro.props;
---

<Section title={t(locale, 'section.about')} id="sobre">
  <GlassCard>
    <p class="mb-6 text-base leading-relaxed text-slate-700 dark:text-slate-300">
      {resume.summary}
    </p>

    {resume.summaryBullets.length > 0 && (
      <ul class="space-y-3">
        {resume.summaryBullets.map(({ label, text }) => (
          <li class="flex gap-3">
            <span class="mt-0.5 shrink-0 text-emerald-500 dark:text-emerald-400">
              <!-- Ícone de chevron-right -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </span>
            <span class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              <strong class="font-semibold text-slate-800 dark:text-slate-200">{label}:</strong>
              {' '}{text}
            </span>
          </li>
        ))}
      </ul>
    )}

    {resume.stack && (
      <div class="mt-6 rounded-xl bg-white/40 p-4 dark:bg-slate-800/30">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-1">Stack</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">{resume.stack}</p>
      </div>
    )}
  </GlassCard>
</Section>
