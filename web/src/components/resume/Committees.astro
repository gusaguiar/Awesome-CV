---
import Section from '@/components/ui/Section.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import { t, type Locale } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  resume: CollectionEntry<'resume'>['data'];
  locale: Locale;
}

const { resume, locale } = Astro.props;
---

<Section title={t(locale, 'section.committees')} id="avaliacoes">
  <div class="space-y-3">
    {resume.committees.map((item) => (
      <GlassCard hoverable id={item.id}>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-slate-900 dark:text-slate-100">{item.title}</p>
            <p class="text-sm text-emerald-600 dark:text-emerald-400">{item.position}</p>
          </div>
          <div class="flex items-center gap-3 text-xs text-slate-400 dark:text-slate-500 shrink-0">
            <span>{item.location}</span>
            <time class="font-mono">{item.date}</time>
          </div>
        </div>

        {item.recommendation && (
          <details class="mt-3 border-t border-white/20 pt-3 dark:border-white/10">
            <summary class="cursor-pointer text-xs font-medium text-emerald-600 dark:text-emerald-400
                            hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors select-none">
              {locale === 'pt-br' ? 'Ver recomendação' : 'View recommendation'}
            </summary>
            <blockquote class="mt-3 rounded-lg bg-white/30 p-3 dark:bg-slate-800/30">
              <p class="text-sm italic leading-relaxed text-slate-700 dark:text-slate-300">
                "{item.recommendation}"
              </p>
            </blockquote>
          </details>
        )}
      </GlassCard>
    ))}
  </div>
</Section>
