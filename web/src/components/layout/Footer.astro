---
import { t, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t border-slate-200/60 dark:border-slate-800/60
         bg-white/40 dark:bg-slate-900/40 backdrop-blur-sm"
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        &copy; {year} {t(locale, 'meta.author')}. {t(locale, 'footer.rights')}
      </p>

      <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
        <a
          href="https://github.com/gusaguiar"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/gjmaguiar"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
        <a
          href="https://researchgate.net/profile/Gustavo_Aguiar4"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          aria-label="ResearchGate"
        >
          ResearchGate
        </a>
      </div>
    </div>
  </div>
</footer>
