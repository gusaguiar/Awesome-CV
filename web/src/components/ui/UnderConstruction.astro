---
import GlassCard from '@/components/ui/GlassCard.astro';
import { t, type Locale } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resumeHref = localePath(locale, '/');
---

<GlassCard class="mx-auto max-w-lg py-20 text-center">
  <!-- Icone de construcao (cone de sinalizacao) -->
  <div class="mb-6 flex justify-center">
    <span class="inline-flex h-20 w-20 items-center justify-center rounded-full
                 bg-emerald-50 dark:bg-emerald-900/30">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-emerald-600 dark:text-emerald-400"
        aria-hidden="true"
      >
        <!-- Wrench icon representando trabalho em andamento -->
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </span>
  </div>

  <h1 class="mb-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    {t(locale, 'construction.title')}
  </h1>

  <p class="mb-8 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
    {t(locale, 'construction.description')}
  </p>

  <a
    href={resumeHref}
    class="inline-flex items-center gap-2 rounded-xl
           bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white
           shadow-[0_4px_16px_rgba(16,185,129,0.3)]
           hover:bg-emerald-700 hover:shadow-[0_4px_20px_rgba(16,185,129,0.4)]
           dark:bg-emerald-500 dark:hover:bg-emerald-600
           transition-all duration-200"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"/>
    </svg>
    {t(locale, 'construction.cta')}
  </a>
</GlassCard>
