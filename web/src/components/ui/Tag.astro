---
// Badge/Tag usado para skills, tecnologias e categorias.

interface Props {
  variant?: 'emerald' | 'slate' | 'sky' | 'violet';
  class?: string;
}

const { variant = 'emerald', class: extraClass = '' } = Astro.props;

const variantClasses: Record<string, string> = {
  emerald: 'bg-emerald-100/80 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300 ring-1 ring-emerald-500/20',
  slate:   'bg-slate-100/80 text-slate-700 dark:bg-slate-800/60 dark:text-slate-300 ring-1 ring-slate-400/20',
  sky:     'bg-sky-100/80 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300 ring-1 ring-sky-500/20',
  violet:  'bg-violet-100/80 text-violet-800 dark:bg-violet-900/30 dark:text-violet-300 ring-1 ring-violet-500/20',
};
---

<span
  class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${variantClasses[variant]} ${extraClass}`}
>
  <slot />
</span>
