---
// Esferas borradas de fundo que criam o efeito glassmorphism.
// Posicionadas como fixed para cobrir toda a viewport.
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <!-- Esfera esmeralda (primária) – canto superior direito -->
  <div
    class="absolute -right-64 -top-64 h-[600px] w-[600px] rounded-full
           bg-emerald-400/20 dark:bg-emerald-500/10
           blur-3xl"
  ></div>

  <!-- Esfera azul-céu – canto inferior esquerdo -->
  <div
    class="absolute -bottom-64 -left-64 h-[500px] w-[500px] rounded-full
           bg-sky-400/20 dark:bg-sky-500/10
           blur-3xl"
  ></div>

  <!-- Esfera violeta – centro à direita -->
  <div
    class="absolute bottom-1/3 right-1/4 h-[400px] w-[400px] rounded-full
           bg-violet-400/15 dark:bg-violet-500/8
           blur-3xl"
  ></div>

  <!-- Gradiente de fundo base -->
  <div
    class="absolute inset-0
           bg-gradient-to-br from-slate-50 via-white to-slate-100
           dark:from-slate-950 dark:via-slate-900 dark:to-slate-950"
  ></div>
</div>
