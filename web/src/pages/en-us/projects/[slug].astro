---
import ContentLayout from '@/layouts/ContentLayout.astro';
import Tag from '@/components/ui/Tag.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { t, type Locale } from '@/i18n/ui';

// Section under construction: no dynamic pages are generated for now.
export async function getStaticPaths() {
  return [];
}

const locale: Locale = 'en-us';
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<ContentLayout
  title={data.title}
  description={data.description}
  locale={locale}
  tags={data.stack}
  backHref="/en-us/projects"
  backLabel={t(locale, 'projects.back')}
>
  <GlassCard class="mb-8 not-prose">
    <dl class="grid gap-3 sm:grid-cols-2">
      {data.role && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">{t(locale, 'projects.role')}</dt>
          <dd class="mt-1 text-sm text-slate-700 dark:text-slate-300">{data.role}</dd>
        </div>
      )}
      {data.period && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">{t(locale, 'projects.period')}</dt>
          <dd class="mt-1 text-sm text-slate-700 dark:text-slate-300">{data.period}</dd>
        </div>
      )}
      <div class="sm:col-span-2">
        <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">{t(locale, 'projects.stack')}</dt>
        <dd class="flex flex-wrap gap-1.5">
          {data.stack.map((tech) => <Tag variant="slate">{tech}</Tag>)}
        </dd>
      </div>
    </dl>

    <div class="mt-4 flex gap-3 border-t border-white/20 pt-4 dark:border-white/10">
      <a
        href={data.repository}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white
               hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        {t(locale, 'projects.viewRepo')}
      </a>

      {data.demo && (
        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700
                 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          {t(locale, 'projects.viewDemo')}
        </a>
      )}
    </div>
  </GlassCard>

  <Content />
</ContentLayout>
