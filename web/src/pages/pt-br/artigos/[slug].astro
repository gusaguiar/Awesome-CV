---
import ContentLayout from '@/layouts/ContentLayout.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { t, type Locale } from '@/i18n/ui';
import { readingTime } from '@/i18n/utils';

// Secao em construcao: nenhuma pagina dinamica e gerada por enquanto.
export async function getStaticPaths() {
  return [];
}

const locale: Locale = 'pt-br';
const { article } = Astro.props;
const { Content } = await render(article);
const minutes = readingTime(article.body ?? '');

// Busca artigos relacionados pelo campo relatedIds
const allArticles = await getCollection('articles', (e) => e.data.locale === locale && !e.data.draft);
const related = article.data.relatedIds.length > 0
  ? allArticles.filter((a) => article.data.relatedIds.includes(a.data.id))
  : [];
---

<ContentLayout
  title={article.data.title}
  description={article.data.description}
  locale={locale}
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  tags={article.data.tags}
  backHref="/pt-br/artigos"
  backLabel={t(locale, 'articles.back')}
>
  <Content />

  <!-- Artigos relacionados -->
  {related.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-6 text-xl font-semibold text-slate-900 dark:text-slate-100">
        {t(locale, 'articles.related')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {related.map((rel) => (
          <ArticleCard article={rel} locale={locale} />
        ))}
      </div>
    </section>
  )}
</ContentLayout>
